# Copy to .env.local and fill in. Only the Supabase values are required;
# every other integration falls back to mock mode when its key is missing.

# Supabase (required). For a keyless local run use the mock server:
#   npm run mock:db   ->  NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321, any anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude drafts the outreach email (/api/draft). Missing = canned email.
ANTHROPIC_API_KEY=

# Fiber AI finds leads (/api/find). Missing = three fake leads.
FIBER_API_KEY=

# ElevenLabs voice agent (/talk/[id]). Missing agent id = Simulate call button.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Gmail SMTP (/api/send). Missing = email is logged, lead still moves to sent.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public base URL used in talk links, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# Expected Parrot (panel/panel.py and maritime-agent). Missing = use --mock.
EXPECTED_PARROT_API_KEY=

# Maritime-hosted rehearsal agent (/api/rehearse). Missing = lead stays
# `drafted` and the local panel/panel.py script picks it up.
MARITIME_API_KEY=
MARITIME_AGENT_ID=
